{
  "name": "@cruglobal/cornerstone-components",
  "publishConfig": {
    "access": "restricted"
  },
  "description": "The custom-element library of the Cornerstone design system.",
  "version": "0.1.0",
  "homepage": "https://cruglobal.github.io/cornerstone-design-system",
  "author": "Cru Global",
  "license": "MIT",
  "customElements": "dist/unbundled/custom-elements.json",
  "web-types": "./dist/unbundled/web-types.json",
  "type": "module",
  "types": "dist/unbundled/cornerstone.d.ts",
  "jsdelivr": "./dist/bundled/cornerstone.loader.js",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/unbundled/cornerstone.d.ts",
      "import": "./dist/unbundled/cornerstone.js"
    },
    "./custom-elements.json": "./dist/unbundled/custom-elements.json",
    "./custom-elements-jsx.d.ts": "./dist/unbundled/custom-elements-jsx.d.ts",
    "./cornerstone.js": "./dist/unbundled/cornerstone.js",
    "./all": "./dist/bundled/cornerstone.all.js",
    "./cornerstone.loader.js": "./dist/unbundled/cornerstone.loader.js",
    "./cornerstone.ssr-loader.js": "./dist/unbundled/cornerstone.ssr-loader.js",
    "./styles/*": "./dist/unbundled/styles/*",
    "./components/*": "./dist/unbundled/components/*",
    "./react": "./dist/unbundled/react/index.js",
    "./react/*": "./dist/unbundled/react/*",
    "./translations/*": "./dist/unbundled/translations/*",
    "./utilities/*": "./dist/unbundled/utilities/*",
    "./events/*": "./dist/unbundled/events/*",
    "./ssr/*": "./dist/unbundled/ssr/*",
    "./bundled/*": "./dist/bundled/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "NOTICE",
    "dist"
  ],
  "keywords": [
    "web components",
    "custom elements",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CruGlobal/cornerstone-design-system.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/CruGlobal/cornerstone-design-system/issues"
  },
  "scripts": {
    "start": "node scripts/build.js --develop --no-incremental",
    "build": "node scripts/build.js",
    "build:serve": "npm run build && npm --prefix ../docs run build && npm --prefix ../docs run preview",
    "create": "plop --plopfile scripts/plop/plopfile.js",
    "pretest": "node scripts/reap-browsers.js",
    "test": "web-test-runner --group default",
    "test:server": "SSR_ONLY=\"true\" npm run test",
    "test:client": "CSR_ONLY=\"true\" npm run test",
    "test:component": "web-test-runner -- --watch --group",
    "test:component:server": "SSR_ONLY=\"true\" npm run test:component",
    "test:component:client": "CSR_ONLY=\"true\" npm run test:component",
    "test:hydration": "node scripts/check-hydration.js",
    "test:parts": "node scripts/check-css-parts.js",
    "test:base-path": "node scripts/check-base-path.js",
    "test:docs-url": "node scripts/check-docs-url.js",
    "test:watch": "web-test-runner --watch --group default",
    "prettier": "prettier --check --log-level=warn --ignore-path=\".prettierignore\" .",
    "prettier:fix": "prettier --write --log-level=warn --ignore-path=\".prettierignore\" .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell \"{src,scripts}/**/*.{js,ts,json,css,md}\" --no-progress --config=\"cspell.json\"",
    "check-types": "tsc --noEmit",
    "verify:skills": "node scripts/verify-skills.js",
    "verify": "npm run prettier && npm run build && npm run lint && npm run spellcheck && npm run check-types && npm run test:parts && npm run test:base-path && npm run test:docs-url && npm run verify:skills && npm run test",
    "prepublishOnly": "npm run verify",
    "check-updates": "npm-check-updates --cooldown 7 --interactive --format group",
    "print-version": "echo $npm_package_version",
    "tag-version": "git tag -a \"v$(npm run print-version | tail -n1)\" -m \"tag v$(npm run print-version | tail -n1)\"",
    "start:docs": "npm --prefix ../docs run dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ctrl/tinycolor": "4.1.0",
    "@floating-ui/dom": "^1.6.13",
    "@konnorr/qr-creator": "^1.0.1",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit/context": "^1.1.6",
    "@lit/react": "^1.0.8",
    "@shoelace-style/animations": "^1.2.0",
    "@shoelace-style/localize": "^3.2.3",
    "composed-offset-position": "^0.0.6",
    "lit": "^3.2.1",
    "marked": "^11.2.0",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@cruglobal/cornerstone-build-tools": "*",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@lit-labs/testing": "^0.2.5",
    "@open-wc/testing": "^3.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.28",
    "@wc-toolkit/cem-inheritance": "^1.2.2",
    "@wc-toolkit/cem-validator": "^1.0.3",
    "@wc-toolkit/jsx-types": "^1.6.0",
    "@wc-toolkit/type-parser": "^1.2.0",
    "@web/dev-server-esbuild": "^0.3.6",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "browser-sync": "^2.29.3",
    "chalk": "^5.3.0",
    "change-case": "^4.1.2",
    "chokidar": "^3.5.3",
    "colorjs.io": "^0.6.0-alpha.1",
    "command-line-args": "^5.2.1",
    "comment-parser": "^1.4.1",
    "cspell": "^6.18.1",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-svelte-integration": "^1.2.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "custom-element-vuejs-integration": "^1.4.0",
    "del": "^7.1.0",
    "download": "^8.0.0",
    "esbuild": "0.25.12",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "front-matter": "^4.0.2",
    "get-port": "^7.1.0",
    "globals": "^17.11.0",
    "globby": "^13.2.2",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "npm-check-updates": "^19.1.2",
    "open": "^11.0.0",
    "ora": "^8.1.1",
    "pascal-case": "^3.1.2",
    "playwright": "1.52.0",
    "plop": "^4.0.1",
    "prettier": "^3.8.3",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "recursive-copy": "^2.0.14",
    "sinon": "^16.1.0",
    "source-map": "^0.7.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "user-agent-data-types": "^0.4.2",
    "uuid": "^9.0.1"
  }
}
