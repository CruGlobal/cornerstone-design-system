---
const asset = (path) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
import { fonts, palettes, themes } from '../../../themer.js';

/**
 * The theme showcase, rendered in the two frames on the Built-in Themes page.
 *
 * A standalone document rather than a content page: it is the thing being previewed, so it carries its own
 * `<head>`, loads every theme and palette, and takes the one to apply from the query string. Both frames on
 * the themes page point here — one with `color-scheme=dark` — and the picker reclasses their documents in
 * place rather than reloading them.
 *
 * A page under `src/pages/` rather than a file in `public/`, because the three `<link>` lists are generated
 * from the themer data. Dropping a palette into `docs/_data/themer.js` puts it in here as well as in the
 * picker, which is the whole point of generating both from one list.
 *
 * Ported from `docs/examples/themes/showcase.njk`. The markup is upstream's, unchanged except for the
 * icons: upstream's names are Font Awesome, several of them Pro, and this fork resolves Material Symbols,
 * so each is swapped for the glyph that means the same thing. The demo's copy is still upstream's — Star
 * Wars and Tolkien — and is a candidate for Cru's own content when someone revises it.
 */
---
<!doctype html>
<html lang="en" class="cs-cloak">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Theme Showcase</title>

    <!-- Cornerstone -->
    <link rel="stylesheet" href={asset("/dist/styles/cornerstone.css")} />

    <script type="module" is:inline src={asset("/dist/cornerstone.loader.js")}></script>

    <!-- Every theme, palette and webfont, so switching one needs no reload -->
    {themes.map((theme) => <link rel="stylesheet" href={asset(`/dist/styles/themes/${theme.filename}`)} />)}
    {palettes.map((palette) => <link rel="stylesheet" href={asset(`/dist/styles/color/palettes/${palette.filename}`)} />)}
    {fonts.filter((font) => font.href).map((font) => <link rel="stylesheet" href={font.href} />)}

    <!-- Set the initial theme, palette, variants, and color scheme based on URL params -->
    <script type="module" is:inline>
      const htmlElement = document.documentElement;
      const urlParams = new URLSearchParams(window.location.search);

      function setClass(prefix, value) {
        if (!value) return;
        htmlElement.classList.forEach(className => {
          if (className.startsWith(prefix)) htmlElement.classList.remove(className);
        });
        htmlElement.classList.add(`${prefix}${value}`);
      }

      // Color scheme
      const colorScheme = urlParams.get('color-scheme');
      if (colorScheme === 'dark') {
        htmlElement.classList.add('cs-dark');
      } else if (colorScheme === 'light') {
        htmlElement.classList.remove('cs-dark');
      }

      // Theme, palette, and variant color assignments
      setClass('cs-theme-', urlParams.get('theme'));
      setClass('cs-palette-', urlParams.get('palette'));
      ['brand', 'neutral', 'success', 'warning', 'danger'].forEach(variant => {
        setClass(`cs-${variant}-`, urlParams.get(`color-${variant}`));
      });
    </script>

  </head>
  <body>
    <div class="showcase-examples-wrapper" aria-hidden="true" data-no-outline>
      <div class="showcase-examples">
        <cs-card>
          <div slot="header" class="cs-split">
            <h3 class="cs-heading-l">Your Cart</h3>
            <cs-button appearance="plain" size="s" tabindex="-1">
              <cs-icon name="close" label="Close"></cs-icon>
            </cs-button>
          </div>
          <div class="cs-stack cs-gap-xl">
            <div class="cs-flank">
              <cs-avatar
                shape="rounded"
                style="background-color: var(--cs-color-green-60); color: var(--cs-color-green-95)"
              >
                <cs-icon slot="icon" name="wand_shine"></cs-icon>
              </cs-avatar>
              <div class="cs-stack cs-gap-2xs">
                <div class="cs-split cs-gap-2xs">
                  <strong>Initiate Saber</strong>
                  <strong>$179.99</strong>
                </div>
                <div class="cs-split cs-gap-2xs cs-caption-s">
                  <span>Green</span>
                  <a href="#" tabindex="-1">Remove</a>
                </div>
              </div>
            </div>
            <cs-divider></cs-divider>
            <div class="cs-flank">
              <cs-avatar
                shape="rounded"
                style="background-color: var(--cs-color-cyan-60); color: var(--cs-color-cyan-95)"
              >
                <cs-icon slot="icon" name="smart_toy"></cs-icon>
              </cs-avatar>
              <div class="cs-stack cs-gap-2xs">
                <div class="cs-split cs-gap-2xs">
                  <strong>Repair Droid</strong>
                  <strong>$3,049.99</strong>
                </div>
                <div class="cs-split cs-gap-2xs cs-caption-s">
                  <span>R-series</span>
                  <a href="#" tabindex="-1">Remove</a>
                </div>
              </div>
            </div>
          </div>
          <div slot="footer" class="cs-stack">
            <div class="cs-split">
              <strong>Subtotal</strong>
              <strong>$3,229.98</strong>
            </div>
            <span class="cs-caption-s">Shipping and taxes calculated at checkout.</span>
            <cs-button tabindex="-1" variant="brand">
              <cs-icon slot="start" name="shopping_bag"></cs-icon>
              Checkout
            </cs-button>
          </div>
        </cs-card>
        <cs-card>
          <cs-avatar shape="rounded" style="--size: 1.8lh; float: left; margin-right: var(--cs-space-m)">
            <cs-icon slot="icon" name="wand_stars" style="font-size: 1.75em"></cs-icon>
          </cs-avatar>
          <p class="cs-body-l" style="margin: 0; font-family: var(--cs-font-family-longform); font-weight: var(--cs-font-weight-longform)">
            &ldquo;All we have to decide is what to do with the time that is given to us. There are other forces at work
            in this world, Frodo, besides the will of evil.&rdquo;
          </p>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <h3 class="cs-heading-l">Sign In</h3>
            <cs-input tabindex="-1" label="Email" placeholder="ddjarin@mandalore.gov" inert>
              <cs-icon slot="start" name="mail"></cs-icon>
            </cs-input>
            <cs-input tabindex="-1" label="Password" type="password" inert>
              <cs-icon slot="start" name="lock"></cs-icon>
            </cs-input>
            <cs-button tabindex="-1" variant="brand">Sign In</cs-button>
            <a href="#" tabindex="-1" class="cs-body-s">I forgot my password</a>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <div class="cs-split">
              <h3 class="cs-heading-l">To-Do</h3>
              <cs-button appearance="plain" size="s" tabindex="-1">
                <cs-icon name="add" label="Add task"></cs-icon>
              </cs-button>
            </div>
            <cs-checkbox tabindex="-1" checked>Umbrella for Adelard</cs-checkbox>
            <cs-checkbox tabindex="-1" checked>Waste-paper basket for Dora</cs-checkbox>
            <cs-checkbox tabindex="-1" checked>Pen and ink for Milo</cs-checkbox>
            <cs-checkbox tabindex="-1">Mirror for Angelica</cs-checkbox>
            <cs-checkbox tabindex="-1">Silver spoons for Lobelia</cs-checkbox>
          </div>
          <div slot="footer">
            <a href="" tabindex="-1">View all completed</a>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <div class="cs-frame cs-border-radius-m" style="align-self: center; max-inline-size: 25ch">
              <img src="https://images.unsplash.com/photo-1667514627762-521b1c815a89?q=20" alt="Album art" />
            </div>
            <div class="cs-flank:end cs-align-items-start">
              <div class="cs-stack cs-gap-3xs">
                <div class="cs-cluster cs-gap-xs" style="height: 2.25em">
                  <strong>The Stone Troll</strong>
                  <small><cs-badge variant="neutral" appearance="filled">E</cs-badge></small>
                </div>
                <span class="cs-caption-s">Samwise G</span>
              </div>
              <cs-button appearance="plain" size="s" tabindex="-1">
                <cs-icon name="more_horiz" label="Options"></cs-icon>
              </cs-button>
            </div>
            <div class="cs-stack cs-gap-2xs">
              <cs-progress-bar value="34"></cs-progress-bar>
              <div class="cs-split">
                <span class="cs-caption-2xs">1:01</span>
                <span class="cs-caption-2xs">-1:58</span>
              </div>
            </div>
            <div class="cs-grid cs-align-items-center" style="--min-column-size: 1em; justify-items: center">
              <cs-button appearance="plain" tabindex="-1">
                <cs-icon name="fast_rewind" label="Skip backward" variant="fill"></cs-icon>
              </cs-button>
              <cs-button appearance="plain" size="l" tabindex="-1">
                <cs-icon name="pause" label="Pause" variant="fill"></cs-icon>
              </cs-button>
              <cs-button appearance="plain" tabindex="-1">
                <cs-icon name="fast_forward" label="Skip forward" variant="fill"></cs-icon>
              </cs-button>
            </div>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <h3 class="cs-heading-l">Chalmun's Spaceport Cantina</h3>
            <div class="cs-cluster cs-gap-xs">
              <cs-rating value="4.6" readonly tabindex="-1"></cs-rating>
              <strong>4.6</strong>
              <span>(419 reviews)</span>
            </div>
            <div class="cs-cluster cs-gap-xs">
              <div class="cs-cluster cs-gap-3xs">
                <cs-icon name="attach_money" style="color: var(--cs-color-green-60)"></cs-icon>
                <cs-icon name="attach_money" style="color: var(--cs-color-green-60)"></cs-icon>
                <cs-icon name="attach_money" style="color: var(--cs-color-green-60)"></cs-icon>
              </div>
              <span class="cs-caption-s">&bull;</span>
              <cs-tag size="s">Cocktail Bar</cs-tag>
              <cs-tag size="s">Gastropub</cs-tag>
              <cs-tag size="s">Local Fare</cs-tag>
            </div>
            <div class="cs-flank cs-gap-xs">
              <cs-icon name="location_on"></cs-icon>
              <a href="#" class="cs-caption-s" tabindex="-1">Mos Eisley, Tatooine</a>
            </div>
          </div>
        </cs-card>
        <cs-card appearance="plain" style="--spacing: 0;">
          <div class="cs-stack cs-gap-s">
            <cs-callout variant="success">
              <cs-icon slot="icon" name="shield_person" variant="fill"></cs-icon>
              <div class="cs-split">
                <span>This is the way.</span>
                <cs-button variant="success" size="s">
                  Follow the Creed
                </cs-button>
              </div>
            </cs-callout>
            <cs-callout variant="warning">
              <cs-icon slot="icon" name="flight"></cs-icon>
              <div class="cs-split">
                <span>It's a trap!</span>
                <cs-button variant="warning" size="s">
                  Take Evasive Action
                </cs-button>
              </div>
            </cs-callout>
            <cs-callout variant="danger">
              <cs-icon slot="icon" name="dark_mode" variant="fill"></cs-icon>
              <div class="cs-split">
                <span>That's no moon.</span>
                <cs-button variant="danger" size="s">
                  Turn Around
                </cs-button>
              </div>
            </cs-callout>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <div class="cs-flank:end">
              <h3 id="odds-label" class="cs-heading-l">Tell Me the Odds</h3>
              <cs-switch size="l" aria-labelledby="odds-label" tabindex="-1"></cs-switch>
            </div>
            <p class="cs-body-s">
              Allow protocol droids to inform you of probabilities, such as the success rate of navigating an asteroid
              field. We recommend setting this to "Never."
            </p>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <div class="cs-split cs-align-items-start">
              <dl class="cs-stack cs-gap-2xs">
                <dt class="cs-heading-m">Amount</dt>
                <dd class="cs-heading-xl">$5,610.00</dd>
              </dl>
              <cs-badge appearance="filled-outlined" variant="success">Paid</cs-badge>
            </div>
            <cs-divider></cs-divider>
            <dl class="cs-stack">
              <div class="cs-flank cs-align-items-center">
                <dt><cs-icon name="person" label="Name" variant="fill"></cs-icon></dt>
                <dd>Tom Bombadil</dd>
              </div>
              <div class="cs-flank cs-align-items-center">
                <dt><cs-icon name="calendar_month" label="Date"></cs-icon></dt>
                <dd><cs-format-date date="2025-03-15"></cs-format-date></dd>
              </div>
              <div class="cs-flank cs-align-items-center">
                <dt><cs-icon name="payments"></cs-icon></dt>
                <dd>Paid with copper pennies</dd>
              </div>
            </dl>
          </div>
          <div slot="footer">
            <a href="" class="cs-cluster cs-gap-2xs" tabindex="-1">
              <span>Download Receipt</span>
              <cs-icon name="arrow_forward"></cs-icon>
            </a>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-stack">
            <div class="cs-split">
              <div class="cs-cluster cs-heading-xl">
                <cs-icon name="menu_book"></cs-icon>
                <h3>Fellowship</h3>
              </div>
              <cs-badge>Most Popular</cs-badge>
            </div>
            <span class="cs-flank cs-align-items-baseline cs-gap-2xs">
              <span class="cs-heading-3xl">$120</span>
              <span class="cs-caption-m">per year</span>
            </span>
            <p class="cs-caption-m">Carry great power (and great responsibility).</p>
            <cs-button variant="brand" tabindex="-1">Get this Plan</cs-button>
          </div>
          <div slot="footer" class="cs-stack cs-gap-s">
            <h4 class="cs-heading-m">What You Get</h4>
            <div class="cs-stack">
              <div class="cs-flank">
                <cs-icon name="person" variant="fill"></cs-icon>
                <span class="cs-caption-s">9 users</span>
              </div>
              <div class="cs-flank">
                <cs-icon name="diamond"></cs-icon>
                <span class="cs-caption-s">1 ring</span>
              </div>
              <div class="cs-flank">
                <cs-icon name="chess_rook"></cs-icon>
                <span class="cs-caption-s">API access to Isengard</span>
              </div>
              <div class="cs-flank">
                <cs-icon name="eco"></cs-icon>
                <span class="cs-caption-s">Priority eagle support</span>
              </div>
            </div>
          </div>
        </cs-card>
        <cs-card class="showcase-code-sample">
          <pre>
&lt;<span class="tag">div</span> <span class="attribute">class</span>="<span class="value">fellowship</span>"&gt;
  &lt;<span class="tag">p</span> <span class="attribute">class</span>="<span class="value">ring-bearer</span>"&gt;Frodo carries the &lt;<span class="tag">span</span> <span class="attribute">id</span>="<span class="value">one-ring</span>"&gt;One Ring&lt;/<span class="tag">span</span>&gt;&lt;/<span class="tag">p</span>&gt;
  &lt;<span class="tag">ul</span> <span class="attribute">class</span>="<span class="value">companions</span>"&gt;
    &lt;<span class="tag">li</span> <span class="attribute">data-race</span>="<span class="value">wizard</span>"&gt;Gandalf the Grey&lt;/<span class="tag">li</span>&gt;
    &lt;<span class="tag">li</span> <span class="attribute">data-race</span>="<span class="value">elf</span>"&gt;Legolas&lt;/<span class="tag">li</span>&gt;
    &lt;<span class="tag">li</span> <span class="attribute">data-race</span>="<span class="value">dwarf</span>"&gt;Gimli&lt;/<span class="tag">li</span>&gt;
  &lt;/<span class="tag">ul</span>&gt;
&lt;/<span class="tag">div</span>&gt;</pre>
        </cs-card>
        <cs-card with-footer>
          <div class="cs-flank:end">
            <div class="cs-stack cs-gap-xs">
              <div class="cs-cluster cs-gap-xs">
                <h3 class="cs-heading-m">Migs Mayfeld</h3>
                <cs-badge pill>Admin</cs-badge>
              </div>
              <span class="cs-caption-s">Imperial Sharpshooter</span>
            </div>
            <cs-avatar
              image="https://images.unsplash.com/photo-1633268335280-a41fbde58707?q=80&w=3348&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
              label="Avatar of a man wearing a sci-fi helmet (Photograph by Nandu Vasudevan)"
            ></cs-avatar>
          </div>
          <div slot="footer" class="cs-grid cs-gap-xs" style="--min-column-size: 10ch">
            <cs-button appearance="outlined" tabindex="-1">
              <cs-icon slot="start" name="alternate_email"></cs-icon>
              Email
            </cs-button>
            <cs-button appearance="outlined" tabindex="-1">
              <cs-icon slot="start" name="call" variant="fill"></cs-icon>
              Phone
            </cs-button>
          </div>
        </cs-card>
        <cs-card>
          <div class="cs-flank:end">
            <a href="" class="cs-flank cs-link-plain" tabindex="-1">
              <cs-avatar
                shape="rounded"
                style="background-color: var(--cs-color-yellow-90); color: var(--cs-color-yellow-50)"
              >
                <cs-icon slot="icon" name="egg"></cs-icon>
              </cs-avatar>
              <div class="cs-gap-2xs cs-stack">
                <span class="cs-heading-m">Second Breakfast</span>
                <span class="cs-caption-s">19 Items</span>
              </div>
            </a>
            <cs-dropdown>
              <cs-button id="more-actions-2" slot="trigger" appearance="plain" size="s" tabindex="-1">
                <cs-icon name="more_vert" label="View menu"></cs-icon>
              </cs-button>
              <cs-dropdown-item>Copy link</cs-dropdown-item>
              <cs-dropdown-item>Rename</cs-dropdown-item>
              <cs-dropdown-item>Move to trash</cs-dropdown-item>
            </cs-dropdown>
            <cs-tooltip for="more-actions-2">View menu</cs-tooltip>
          </div>
        </cs-card>
        <cs-card with-header with-footer>
          <div slot="header" class="cs-stack cs-gap-xs">
            <h2 class="cs-heading-l">Decks</h2>
          </div>
          <div class="cs-stack cs-gap-xl">
            <p class="cs-caption-s">
              You haven't created any decks yet. Get started by selecting an aspect that matches your play style.
            </p>
            <div class="cs-grid cs-gap-xl" style="--min-column-size: 30ch">
              <a href="" class="cs-flank cs-align-items-start cs-link-plain" tabindex="-1">
                <cs-avatar
                  shape="rounded"
                  style="background-color: var(--cs-color-sky-90); color: var(--cs-color-sky-50)"
                >
                  <cs-icon slot="icon" name="shield"></cs-icon>
                </cs-avatar>
                <div class="cs-stack cs-gap-2xs">
                  <span class="cs-align-items-center cs-cluster cs-gap-xs cs-heading-m">
                    Vigilance <cs-icon name="arrow_forward"></cs-icon>
                  </span>
                  <p class="cs-caption-s">Protect, defend, and restore as you ready heavy-hitters.</p>
                </div>
              </a>
              <a href="" class="cs-flank cs-align-items-start cs-link-plain" tabindex="-1">
                <cs-avatar
                  shape="rounded"
                  style="background-color: var(--cs-color-green-90); color: var(--cs-color-green-50)"
                >
                  <cs-icon slot="icon" name="keyboard_double_arrow_up"></cs-icon>
                </cs-avatar>
                <div class="cs-stack cs-gap-2xs">
                  <span class="cs-align-items-center cs-cluster cs-gap-xs cs-heading-m">
                    Command <cs-icon name="arrow_forward"></cs-icon>
                  </span>
                  <p class="cs-caption-s">Build imposing armies and stockpile resources.</p>
                </div>
              </a>
              <a href="" class="cs-flank cs-align-items-start cs-link-plain" tabindex="-1">
                <cs-avatar
                  shape="rounded"
                  style="background-color: var(--cs-color-cerise-90); color: var(--cs-color-cerise-50)"
                >
                  <cs-icon slot="icon" name="explosion" variant="fill"></cs-icon>
                </cs-avatar>
                <div class="cs-stack cs-gap-2xs">
                  <span class="cs-align-items-center cs-cluster cs-gap-xs cs-heading-m">
                    Aggression <cs-icon name="arrow_forward"></cs-icon>
                  </span>
                  <p class="cs-caption-s">Relentlessly deal damage and apply pressure to your opponent.</p>
                </div>
              </a>
              <a href="" class="cs-flank cs-align-items-start cs-link-plain" tabindex="-1">
                <cs-avatar
                  shape="rounded"
                  style="background-color: var(--cs-color-yellow-90); color: var(--cs-color-yellow-50)"
                >
                  <cs-icon slot="icon" name="dark_mode" variant="fill"></cs-icon>
                </cs-avatar>
                <div class="cs-stack cs-gap-2xs">
                  <span class="cs-align-items-center cs-cluster cs-gap-xs cs-heading-m">
                    Cunning <cs-icon name="arrow_forward"></cs-icon>
                  </span>
                  <p class="cs-caption-s">Disrupt and frustrate your opponent with dastardly tricks.</p>
                </div>
              </a>
            </div>
          </div>
          <div slot="footer">
            <a href="" class="cs-cluster cs-gap-xs" tabindex="-1">
              <span>Or start a deck from scratch</span>
              <cs-icon name="arrow_forward"></cs-icon>
            </a>
          </div>
        </cs-card>
      </div>
    </div>

    <!-- Page styles -->
    <style is:global>
      html,
      body {
        height: 100vh;
        overflow: hidden;
        background-color: var(--cs-color-surface-lowered);
      }

      .showcase-examples-wrapper {
        container-type: inline-size;
        inline-size: 100%;
        min-block-size: 100%;
        box-sizing: border-box;
        padding: var(--cs-space-xl);
        background-color: var(--cs-color-surface-lowered);
      }

      .showcase-examples {
        column-count: 1;
        column-gap: var(--cs-space-l);

        & cs-card {
          display: inline-flex;
          width: 100%;

          &:has(+ cs-card) {
            margin-block-end: var(--cs-space-l);
          }

          &[appearance='plain'] {
            background-color: transparent !important;
            border-color: transparent !important;
          }
        }

        @container (width > 500px) {
          column-count: 2;
        }

        @container (width > 750px) {
          column-count: 3;
        }

        @container (width > 950px) {
          column-count: auto;
          column-width: 22rem;
        }
      }

      .showcase-code-sample {
        --spacing: 0;
        overflow: hidden;

        pre {
          color: var(--cs-color-text-quiet);
        }

        .tag {
          color: var(--cs-color-highlight-on-quiet);
        }

        .attribute {
          color: var(--cs-color-success-on-quiet);
        }

        .value {
          color: var(--cs-color-brand-on-quiet);
        }
      }

      cs-progress-bar {
        --track-height: 0.5em;
      }
    </style>
  </body>
</html>
