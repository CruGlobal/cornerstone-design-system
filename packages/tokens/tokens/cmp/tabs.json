          },
          "icon": {
            "$type": "color",
            "$value": "{_sys.color.text.primary}"
          }
        },
        "inactive": {
          "surface": {
            "$type": "color",
            "$value": "{_sys.color.action-surface.default}"
          },
          "surface-hover": {
            "$type": "color",
            "$value": "{_sys.color.action-surface.hover}"
          },
          "surface-pressed": {
            "$type": "color",
            "$value": "{_sys.color.action-surface.pressed}"
          },
          "indicator": {
            "$type": "color",
