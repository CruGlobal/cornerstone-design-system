{
  "_cmp": {
    "accordion": {
      "tab": {
        "border-width": {
          "$type": "number",
          "$value": "{_sys.number.border-width.thin}"
        },
        "color": {
          "on-surface-collapsed": {
            "$type": "color",
            "$value": "{_sys.color.action}"
          },
          "on-surface-expanded": {
            "$type": "color",
            "$value": "{_sys.color.on-surface}"
          },
          "on-surface-disabled": {
            "$type": "color",
            "$value": "{_sys.color.text.disabled}"
          },
          "surface": {
            "$type": "color",
            "$value": "{_sys.color.surface-bright}"
          },
          "border": {
            "$type": "color",
            "$value": "{_sys.color.outline.default}"
          }
        },
        "space": {
          "top-bottom": {
            "$type": "number",
            "$value": "{_sys.number.space.md}"
          },
          "gap": {
            "$type": "number",
            "$value": "{_sys.number.space.md}"
          }
        }
      }
    }
  }
}
