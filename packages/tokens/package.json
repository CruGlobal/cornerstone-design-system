{
  "name": "@cruglobal/cornerstone-design-system",
  "version": "0.11.0",
  "description": "Design tokens and primitives for the Cornerstone Design System.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CruGlobal/cornerstone-design-system.git"
  },
  "homepage": "https://github.com/CruGlobal/cornerstone-design-system#readme",
  "type": "module",
  "main": "./build/js/ref.cjs",
  "types": "./build/js/ref.d.ts",
  "sideEffects": [
    "./build/css/*.css",
    "./build/scss/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./build/js/ref.d.ts",
      "import": "./build/js/ref.mjs",
      "require": "./build/js/ref.cjs"
    },
    "./mui": {
      "types": "./build/mui/index.d.ts",
      "default": "./build/mui/index.js"
    },
    "./tokens/*.json": "./tokens/*.json",
    "./css/*": "./build/css/*.css",
    "./scss/*": "./build/scss/*.scss",
    "./js/*": {
      "types": "./build/js/*.d.ts",
      "import": "./build/js/*.mjs",
      "require": "./build/js/*.cjs"
    },
    "./json/*": "./build/json/*.json",
    "./libraries/*": "./libraries/*",
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "tokens/",
    "libraries/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint build.mjs scripts/",
    "format": "prettier --write build.mjs scripts/",
    "validate": "node scripts/validate-tokens.mjs && node ../components/tools/daisyui.mjs --check",
    "build": "node build.mjs && tsc -p libraries/mui/tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node scripts/check-mui-export.mjs"
  },
  "peerDependencies": {
    "@mui/material": ">=5"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.5.0",
    "@types/react": "^18.3.31",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "style-dictionary": "^5.8.0",
    "typescript": "^5.9.3"
  }
}
